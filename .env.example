# Database
DATABASE_URL=
DATABASE_URL_POOLER=

# Authentication
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AI and voice (Gemini only)
GEMINI_API_KEY=
AI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Private attachments
BLOB_READ_WRITE_TOKEN=

# Public-data caching and deterministic demo behavior.
# Set DEMO_MODE=true only on local or disposable demo deployments to expose
# the shared synthetic admin/admin citizen login.
PUBLIC_DATA_REVALIDATE_SECONDS=21600
DEMO_MODE=false
