# Database
DATABASE_URL=
DATABASE_URL_POOLER=

# Authentication
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AI and voice (Gemini is the Phase 0 provider; alternatives are placeholders)
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_TEXT_MODEL=gemini-3.5-flash-lite
VOICE_PROVIDER=gemini-live
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
BROWSER_VOICE_FALLBACK=true
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Private attachments
BLOB_READ_WRITE_TOKEN=

# Public-data caching and deterministic demo behavior
PUBLIC_DATA_REVALIDATE_SECONDS=21600
DEMO_MODE=true
